{
  "name": "one-of-one",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "check:prod": "npm run build && node scripts/check-prod.mjs",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "fixtures": "node e2e/fixtures/make-fixtures.mjs && node e2e/fixtures/make-exif-fixtures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "piexifjs": "^1.0.6",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "supabase": "^2.121.0",
    "typescript": "~5.9.3"
  }
}
